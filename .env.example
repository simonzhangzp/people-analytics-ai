# Enables five typed Workbench AI tasks. Keep this server-side only.
# Without it, the UI visibly identifies deterministic fallback proposals.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Live v1 site (until cutover) still uses quantreview-staging. Do not retarget
# these public keys to the dedicated People v2 project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Pipeline upserts only. Never expose this to the browser. v2 app must not use
# anon / service_role against people_v2.
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated People v2 project (zapmigfrtnwnkmezjefx). Values stay in Hetzner
# .env / Vercel env — never commit them.
PEOPLE_SUPABASE_URL=https://zapmigfrtnwnkmezjefx.supabase.co
PEOPLE_SUPABASE_DATABASE_PASSWORD=
PEOPLE_PUBLISHER_PASSWORD=
PEOPLE_SUPABASE_POOLER_HOST=
# PEOPLE_SERVING_REF must stay zapmigfrtnwnkmezjefx. v2 case pages do not use NEXT_PUBLIC_SUPABASE_*.
PEOPLE_SERVING_REF=zapmigfrtnwnkmezjefx
# Transaction pooler 6543, role people_app, sslmode=require. Vercel env only.
# postgresql://people_app.zapmigfrtnwnkmezjefx:PASSWORD@HOST:6543/postgres?sslmode=require
PEOPLE_DB_URL=

# Recruiter About page. Leave email blank rather than inventing an address.
NEXT_PUBLIC_BUILDER_LINKEDIN=https://www.linkedin.com/in/simonzp
NEXT_PUBLIC_BUILDER_EMAIL=

# Optional Formulator analysis origin. When unset, /app explains Docker setup
# and offers the browser-local /workbench fallback.
# Local Docker: http://localhost:5567
# Production: https://app.peopleanalyticsai.net
NEXT_PUBLIC_FORMULATOR_URL=

# Public MCP demo token (visitor identity, aggregate only, min_cell 50).
# Same value in PEOPLE_MCP_DEMO_TOKEN (server verify) and NEXT_PUBLIC_MCP_DEMO_TOKEN (Connect page).
PEOPLE_MCP_DEMO_TOKEN=
NEXT_PUBLIC_MCP_DEMO_TOKEN=
# HMAC key for hashing client IPs in people_llm_call. Never commit the live value.
PEOPLE_IP_HASH_SECRET=

# People data platform (server-side pipeline only)
PEOPLE_LAKE_ROOT=
PEOPLE_AS_OF_DATE=2026-08-30
PEOPLE_SYNTHETIC_SEED=20260830
PEOPLE_MONTHLY_PAID_DATA_BUDGET_USD=30
PEOPLE_PAID_DATA_HARD_STOP_USD=28
PEOPLE_DEMO_INCIDENT=apac_hris_incomplete
BLS_API_KEY=
# People v2 database password is read from env only (never from this file).
# PEOPLE_SUPABASE_DATABASE_PASSWORD=
# PEOPLE_PUBLISHER_PASSWORD=
