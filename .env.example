# Enables five typed Workbench AI tasks. Keep this server-side only.
# Without it, the UI visibly identifies deterministic fallback proposals.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Enables anonymous, RLS-protected persistence of safe metadata and organizational
# knowledge. Uploaded files and raw People rows are never persisted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
