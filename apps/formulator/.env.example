# Data Formulator / People overlay
# Copy to apps/formulator/.env (gitignored).

DISABLE_DISPLAY_KEYS=false
SANDBOX=local
WORKSPACE_BACKEND=local
AVAILABLE_LANGUAGES=en,zh

# Flask session signing. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# DeepSeek via Data Formulator's custom provider registry
DEEPSEEK_ENABLED=true
DEEPSEEK_ENDPOINT=openai
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-chat

# Optional OpenAI / Azure / Anthropic / Ollama
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4.1
